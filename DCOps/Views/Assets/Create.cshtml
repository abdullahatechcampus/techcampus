@using DCOps.Web.Models.Entities
@model Asset
@{
    ViewData["Title"] = "إضافة أصل جديد";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="/Assets" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right"></i>
            </a>
            <h5 class="mb-0">إضافة أصل جديد</h5>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post" action="/Assets/Create">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">كود الأصل</label>
                            <input type="text" name="AssetCode" class="form-control" placeholder="مثال: SRV-001 (اتركه فارغاً للتوليد التلقائي)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">اسم الأصل <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" required placeholder="أدخل اسم الأصل" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">نوع الأصل</label>
                            <select name="AssetType" class="form-select">
                                <option value="">-- اختر النوع --</option>
                                <option value="server">خادم (Server)</option>
                                <option value="storage">تخزين (Storage)</option>
                                <option value="network">شبكة (Network)</option>
                                <option value="ups">UPS</option>
                                <option value="cooling">تبريد</option>
                                <option value="power">طاقة</option>
                                <option value="virtual_machine">آلة افتراضية (VM)</option>
                                <option value="other">أخرى</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الفئة</label>
                            <input type="text" name="Category" class="form-control" placeholder="مثال: Physical, Cloud, VMware" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الحالة</label>
                            <select name="Status" class="form-select">
                                <option value="active">نشط</option>
                                <option value="inactive">غير نشط</option>
                                <option value="maintenance">تحت الصيانة</option>
                                <option value="retired">متقاعد</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الموقع</label>
                            <input type="text" name="Location" class="form-control" placeholder="مثال: Rack A-01, Row 3" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الرقم التسلسلي</label>
                            <input type="text" name="SerialNumber" class="form-control" placeholder="S/N" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">عنوان IP</label>
                            <input type="text" name="IpAddress" class="form-control" placeholder="192.168.1.x" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الشركة المصنعة</label>
                            <input type="text" name="Manufacturer" class="form-control" placeholder="Dell, HP, Cisco..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الموديل</label>
                            <input type="text" name="Model" class="form-control" placeholder="موديل الجهاز" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">المالك</label>
                            <input type="text" name="Owner" class="form-control" placeholder="اسم المالك أو المسؤول" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">القسم</label>
                            <input type="text" name="Department" class="form-control" placeholder="القسم المسؤول" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">تاريخ الشراء</label>
                            <input type="date" name="PurchaseDate" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">انتهاء الضمان</label>
                            <input type="date" name="WarrantyExpiry" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">ملاحظات</label>
                            <textarea name="Notes" class="form-control" rows="3" placeholder="ملاحظات إضافية..."></textarea>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Assets" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>إلغاء
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>حفظ الأصل
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
