@using DCOps.Web.Models.Entities
@model Asset
@{
    ViewData["Title"] = "تعديل الأصل";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="/Assets" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right"></i>
            </a>
            <h5 class="mb-0">تعديل الأصل: @Model.Name</h5>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post" action="/Assets/Edit/@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="CreatedAt" value="@Model.CreatedAt.ToString("o")" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">كود الأصل</label>
                            <input type="text" name="AssetCode" class="form-control" value="@Model.AssetCode" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">اسم الأصل <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" value="@Model.Name" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">نوع الأصل</label>
                            <select name="AssetType" class="form-select">
                                <option value="">-- اختر النوع --</option>
                                @foreach (var opt in new[] { ("server","خادم (Server)"),("storage","تخزين (Storage)"),("network","شبكة (Network)"),("ups","UPS"),("cooling","تبريد"),("power","طاقة"),("virtual_machine","آلة افتراضية (VM)"),("other","أخرى") })
                                {
                                    <option value="@opt.Item1" @(Model.AssetType == opt.Item1 ? "selected" : "")>@opt.Item2</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الفئة</label>
                            <input type="text" name="Category" class="form-control" value="@Model.Category" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الحالة</label>
                            <select name="Status" class="form-select">
                                @foreach (var opt in new[] { ("active","نشط"),("inactive","غير نشط"),("maintenance","تحت الصيانة"),("retired","متقاعد") })
                                {
                                    <option value="@opt.Item1" @(Model.Status == opt.Item1 ? "selected" : "")>@opt.Item2</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الموقع</label>
                            <input type="text" name="Location" class="form-control" value="@Model.Location" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الرقم التسلسلي</label>
                            <input type="text" name="SerialNumber" class="form-control" value="@Model.SerialNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">عنوان IP</label>
                            <input type="text" name="IpAddress" class="form-control" value="@Model.IpAddress" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الشركة المصنعة</label>
                            <input type="text" name="Manufacturer" class="form-control" value="@Model.Manufacturer" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الموديل</label>
                            <input type="text" name="Model" class="form-control" value="@Model.Model" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">المالك</label>
                            <input type="text" name="Owner" class="form-control" value="@Model.Owner" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">القسم</label>
                            <input type="text" name="Department" class="form-control" value="@Model.Department" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">تاريخ الشراء</label>
                            <input type="date" name="PurchaseDate" class="form-control" value="@Model.PurchaseDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">انتهاء الضمان</label>
                            <input type="date" name="WarrantyExpiry" class="form-control" value="@Model.WarrantyExpiry?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">ملاحظات</label>
                            <textarea name="Notes" class="form-control" rows="3">@Model.Notes</textarea>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Assets" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>إلغاء
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>حفظ التغييرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
