@using DCOps.Web.Models.Entities
@model WorkOrder
@{
    ViewData["Title"] = "تفاصيل أمر العمل";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="/WorkOrders" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right"></i>
            </a>
            <h5 class="mb-0">تفاصيل أمر العمل</h5>
            <a href="/WorkOrders/Edit/@Model.Id" class="btn btn-primary btn-sm ms-auto">
                <i class="bi bi-pencil me-1"></i>تعديل
            </a>
        </div>

        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-tools me-2"></i>@Model.Title</span>
                @{
                    var statusClass = Model.Status switch { "open" => "bg-primary", "in_progress" => "bg-warning text-dark", "completed" => "bg-success", _ => "bg-secondary" };
                    var statusLabel = Model.Status switch { "open" => "مفتوح", "in_progress" => "قيد التنفيذ", "completed" => "مكتمل", "cancelled" => "ملغي", _ => Model.Status };
                }
                <span class="badge @statusClass">@statusLabel</span>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless">
                    <tr><th class="text-muted" style="width:30%">رقم الأمر</th><td><code>@Model.OrderNo</code></td></tr>
                    <tr><th class="text-muted">النوع</th><td>@(Model.Type ?? "—")</td></tr>
                    <tr><th class="text-muted">الأولوية</th><td>@(Model.Priority ?? "—")</td></tr>
                    <tr><th class="text-muted">المكلف</th><td>@(Model.AssignedTo ?? "—")</td></tr>
                    <tr><th class="text-muted">مقدم الطلب</th><td>@(Model.RequestedBy ?? "—")</td></tr>
                    <tr><th class="text-muted">الموعد المجدول</th><td>@(Model.ScheduledAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td></tr>
                    <tr><th class="text-muted">تاريخ الإنشاء</th><td>@Model.CreatedAt.ToString("dd/MM/yyyy")</td></tr>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <tr><th class="text-muted">الوصف</th><td>@Model.Description</td></tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <tr><th class="text-muted">ملاحظات</th><td>@Model.Notes</td></tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>
