<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DCOps نظام إدارة مراكز البيانات</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #1a2332 0%, #243447 100%); width: 260px; position: fixed; top: 0; right: 0; z-index: 100; box-shadow: -2px 0 10px rgba(0,0,0,0.3); }
        .sidebar .brand { padding: 1.5rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .sidebar .brand h5 { color: #fff; margin: 0; font-weight: 700; }
        .sidebar .brand small { color: #8899aa; font-size: 0.75rem; }
        .sidebar .nav-link { color: #c0ccd8; padding: 0.6rem 1rem; border-radius: 8px; margin: 2px 8px; transition: all 0.2s; display: flex; align-items: center; gap: 10px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: rgba(255,255,255,0.1); color: #fff; }
        .sidebar .nav-link i { font-size: 1.1rem; width: 22px; text-align: center; }
        .sidebar .nav-section { color: #5c7080; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; padding: 1rem 1.5rem 0.3rem; font-weight: 600; }
        .main-content { margin-right: 260px; padding: 0; }
        .topbar { background: #fff; border-bottom: 1px solid #e0e6ed; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 99; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
        .topbar .page-title { font-size: 1.1rem; font-weight: 600; color: #1a2332; margin: 0; }
        .topbar .user-info { display: flex; align-items: center; gap: 12px; }
        .topbar .user-avatar { width: 36px; height: 36px; background: #3b82f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; font-size: 0.9rem; }
        .content-area { padding: 1.5rem; }
        .stat-card { background: #fff; border-radius: 12px; padding: 1.25rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); border: 1px solid #e8ecf0; }
        .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .stat-card .stat-value { font-size: 2rem; font-weight: 700; color: #1a2332; }
        .stat-card .stat-label { color: #6b7c93; font-size: 0.85rem; }
        .card { border: 1px solid #e8ecf0; border-radius: 12px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
        .card-header { background: #f8f9fa; border-bottom: 1px solid #e8ecf0; font-weight: 600; }
        .btn-primary { background: #3b82f6; border-color: #3b82f6; }
        .btn-primary:hover { background: #2563eb; border-color: #2563eb; }
        .table th { background: #f8f9fa; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb; }
        .badge { font-size: 0.75rem; }
        .alert-success-toast { position: fixed; top: 1rem; left: 1rem; z-index: 9999; }
        @@media (max-width: 768px) {
            .sidebar { transform: translateX(100%); transition: transform 0.3s; }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-right: 0; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="brand">
                <h5><i class="bi bi-server me-2"></i>DCOps</h5>
                <small>نظام إدارة مراكز البيانات</small>
            </div>
            <div class="pt-3">
                <div class="nav-section">الرئيسية</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   href="/Dashboard">
                    <i class="bi bi-speedometer2"></i> لوحة التحكم
                </a>

                <div class="nav-section">إدارة الأصول</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assets" ? "active" : "")"
                   href="/Assets">
                    <i class="bi bi-hdd-stack"></i> قاعدة بيانات الأصول
                </a>

                <div class="nav-section">العمليات</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "WorkOrders" ? "active" : "")"
                   href="/WorkOrders">
                    <i class="bi bi-tools"></i> أوامر العمل
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" ? "active" : "")"
                   href="/Maintenance">
                    <i class="bi bi-calendar-check"></i> خطط الصيانة
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequests" ? "active" : "")"
                   href="/ServiceRequests">
                    <i class="bi bi-headset"></i> طلبات الخدمة
                </a>

                <div class="nav-section">الإشعارات والتقارير</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")"
                   href="/Notifications">
                    <i class="bi bi-bell"></i> الإشعارات
                </a>

                <div class="nav-section">الحساب</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")"
                   href="/Account/Profile">
                    <i class="bi bi-person-circle"></i> الملف الشخصي
                </a>
                <form method="post" action="/Account/Logout" style="margin: 2px 8px;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link btn btn-link w-100 text-start" style="border:none; background:none; color:#c0ccd8;">
                        <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
                    </button>
                </form>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            <div class="topbar">
                <h6 class="page-title">@(ViewData["Title"] ?? "لوحة التحكم")</h6>
                <div class="user-info">
                    <a href="/Notifications" class="btn btn-light btn-sm position-relative">
                        <i class="bi bi-bell"></i>
                    </a>
                    <div class="user-avatar">
                        @{ var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "U"; }
                        @(fullName.Length > 0 ? fullName[0].ToString() : "U")
                    </div>
                    <div>
                        <div style="font-weight:600; font-size:0.85rem; color:#1a2332;">@fullName</div>
                        <div style="font-size:0.75rem; color:#6b7c93;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                    </div>
                </div>
            </div>

            <div class="content-area">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
