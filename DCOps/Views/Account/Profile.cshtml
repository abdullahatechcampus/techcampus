@using DCOps.Web.Models.Entities
@model User
@{
    ViewData["Title"] = "الملف الشخصي";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-primary"></i>
                <span>الملف الشخصي</span>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center text-white"
                         style="width:80px;height:80px;font-size:2rem;font-weight:700;">
                        @(Model.FullName?.Length > 0 ? Model.FullName[0].ToString() : "U")
                    </div>
                    <h5 class="mt-3 mb-1">@Model.FullName</h5>
                    <span class="badge bg-primary">@Model.Role</span>
                </div>

                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <th style="width:40%" class="text-muted">اسم المستخدم</th>
                            <td><strong>@Model.Username</strong></td>
                        </tr>
                        <tr>
                            <th class="text-muted">البريد الإلكتروني</th>
                            <td>@(Model.Email ?? "—")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">الدور</th>
                            <td>
                                @{
                                    var roleLabel = Model.Role switch
                                    {
                                        "admin" => "مدير النظام",
                                        "dc_manager" => "مدير مركز البيانات",
                                        "it_manager" => "مدير تقنية المعلومات",
                                        "technician" => "فني",
                                        "viewer" => "مشاهد",
                                        _ => Model.Role
                                    };
                                }
                                @roleLabel
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">الحالة</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">غير نشط</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">تاريخ الإنشاء</th>
                            <td>@Model.CreatedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">آخر تسجيل دخول</th>
                            <td>@(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-end">
                <a href="/Dashboard" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-right me-1"></i>العودة للوحة التحكم
                </a>
            </div>
        </div>
    </div>
</div>
